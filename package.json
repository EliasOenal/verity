{
  "name": "@veritycloud/verity",
  "version": "0.1.25",
  "description": "A decentralised, serverless and censorship-resistant Cloud application platform",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./verity.d.ts",
      "default": "./verity.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    },
    "./webpack.veritycommon.mjs": "./webpack.veritycommon.mjs"
  },
  "scripts": {
    "start": "node --import=extensionless/register dist/verity.js",
    "test": "npm run vitest",
    "test:browser": "npm run vitest -- test/browser/",
    "test:playwright": "npx playwright test",
    "test:playwright:ui": "npx playwright test --ui",
    "test:server": "webpack serve --config webpack.test.mjs",
    "vitest": "./node_modules/.bin/vitest run",
    "webpack": "webpack",
    "build:types": "tsc -p tsconfig.build.json",
    "build:vite": "vite build",
    "build": "npm run build:vite && npm run build:types",
    "postbuild": "cp README.md LICENSE package.json webpack.base.mjs webpack.veritycommon.mjs dist/; cp -r img dist/; cp -r src/webui/static dist/webui/",
    "preparetopublish": "npm run build && jq 'del(.private, .scripts, .devDependencies)' package.json > dist/package.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "server": "webpack serve",
    "prepublishOnly": "echo 'Please run `npm run preparetopublish`, then run `npm publish` from within `dist`' && exit 1",
    "lint": "node_modules/.bin/eslint",
    "chat:build": "webpack --config apps/chat/webpack.config.mjs",
    "chat:serve": "webpack serve --config apps/chat/webpack.config.mjs",
    "chat:build:prod": "webpack --config apps/chat/webpack.prod.config.mjs"
  },
  "author": "Elias Oenal, Victor Hahn",
  "license": "GPL-2.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/jsdom": "^28.0.3",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "axios": "^1.18.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.2",
    "fast-glob": "^3.3.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "promise.withresolvers": "^1.0.3",
    "raw-loader": "^4.0.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.10",
    "vite-raw-plugin": "^1.0.2",
    "vitest": "^4.0.7",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.5",
    "@libp2p/identify": "^4.1.6",
    "@libp2p/mplex": "^12.0.22",
    "@libp2p/ping": "^3.1.5",
    "@libp2p/utils": "^7.2.1",
    "@libp2p/webrtc": "^6.0.23",
    "@libp2p/websockets": "^10.1.13",
    "@multiavatar/multiavatar": "^1.0.7",
    "@scure/bip39": "1.6.0",
    "@types/node": "^24.10.1",
    "abstract-level": "^3.0.1",
    "bencodec": "^3.0.1",
    "browser-or-node": "^3.0.0",
    "buffer": "^6.0.3",
    "cmd-ts": "^0.15.0",
    "data-structure-typed": "^2.1.0",
    "dompurify": "^3.4.11",
    "events": "^3.3.0",
    "extensionless": "^2.0.2",
    "isomorphic-ws": "^5.0.0",
    "it-pipe": "^3.0.1",
    "js-sha3": "^0.9.3",
    "level": "10.0.0",
    "libp2p": "^3.3.1",
    "libsodium-sumo": "^0.8.4",
    "libsodium-wrappers-sumo": "^0.8.4",
    "memory-level": "3.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "process": "^0.11.10",
    "readline": "^1.3.0",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "weakref": "^0.2.4",
    "ws": "^8.20.1"
  },
  "browser": {
    "fs": false,
    "pino": false,
    "pino-pretty": false,
    "readline": false,
    "crypto": false,
    "cmd-ts": false,
    "https": false
  },
  "overrides": {
    "rimraf": "^6.0.1",
    "glob": "^11.0.3"
  }
}
